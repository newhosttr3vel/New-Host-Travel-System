{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "New Host Travel",
  "version": "0.1.0",
  "identifier": "com.newhosttravel.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "New Host Travel",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Travel agency management",
    "longDescription": "Local-first travel agency management for desktop and mobile."
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:newhost-travel.db"]
    }
  }
}