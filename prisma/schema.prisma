generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

enum CompanyApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}
enum TenantRole {
  OWNER
  ADMINISTRATOR
  BRANCH_MANAGER
  RESERVATIONS_MANAGER
  RESERVATIONS_AGENT
  ACCOUNTANT
  SALES
  VISA_OFFICER
  OPERATIONS
  HR_MANAGER
  AUDITOR
  READ_ONLY
}
enum CustomerType {
  INDIVIDUAL
  CORPORATE
}
enum SupplierCategory {
  HOTEL
  AIRLINE
  TRANSPORT
  VISA_PROVIDER
  TOUR_OPERATOR
  OTHER
}
enum ReservationServiceType {
  HOTEL
  FLIGHT
  VISA
  TRANSPORT
  UMRAH_PACKAGE
  HAJJ_PACKAGE
  TOUR
  OTHER
}
enum ReservationStatus {
  INQUIRY
  QUOTATION
  PENDING
  ON_HOLD
  CONFIRMED
  PARTIALLY_PAID
  FULLY_PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  POSTED
}

enum JournalSourceType {
  MANUAL
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  INVOICE
  SUPPLIER_BILL
  REVERSAL
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum SupplierBillStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum CustomerPaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ELECTRONIC_WALLET
  THNDR
  OTHER
}

model User {
  id            String             @id
  name          String
  email         String             @unique
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   TenantMembership[]
  uploadedDocuments Document[] @relation("DocumentUploader")
  companyApplication PlatformCompanyApplication?
  @@map("user")
}
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("session")
}
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@index([userId])
  @@map("account")
}
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
  @@index([lastRequest])
  @@map("rateLimit")
}
model Tenant {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  status          TenantStatus       @default(TRIAL)
  defaultLanguage String             @default("ar")
  defaultCurrency String             @default("EGP")
  timeZone        String             @default("Africa/Cairo")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  memberships     TenantMembership[]
  branches        Branch[]
  branchMemberships BranchMembership[]
  customers       Customer[]
  documents       Document[]
  suppliers       Supplier[]
  hotels          Hotel[]
  reservations    Reservation[]
  auditEvents     AuditEvent[]
  ledgerAccounts  LedgerAccount[]
  journalEntries  JournalEntry[]
  invoices        Invoice[]
  customerPayments CustomerPayment[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]
  hotelReservationDetails HotelReservationDetail[]
  @@index([status, createdAt])
  @@map("tenants")
}
model TenantMembership {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(READ_ONLY)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchAssignments BranchMembership[]
  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@index([userId, createdAt])
  @@map("tenant_memberships")
}
model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships BranchMembership[]
  reservations Reservation[]
  documents Document[]
  journalEntries JournalEntry[]
  invoices Invoice[]
  customerPayments CustomerPayment[]
  supplierBills SupplierBill[]
  supplierPayments SupplierPayment[]
  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("branches")
}
model BranchMembership {
  id           String   @id @default(cuid())
  tenantId     String
  branchId     String
  membershipId String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch   @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@unique([id, tenantId])
  @@unique([branchId, membershipId])
  @@index([tenantId, membershipId])
  @@map("branch_memberships")
}
model Customer {
  id           String       @id @default(cuid())
  tenantId     String
  type         CustomerType @default(INDIVIDUAL)
  name         String
  companyName  String?
  email        String?
  phone        String?
  nationality  String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  archivedAt   DateTime?
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  invoices     Invoice[]
  @@unique([id, tenantId])
  @@index([tenantId, archivedAt, name])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("customers")
}
model Hotel {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  city        String?
  country     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations HotelReservationDetail[]
  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, archivedAt, name])
  @@map("hotels")
}
model Supplier {
  id           String           @id @default(cuid())
  tenantId     String
  name         String
  category     SupplierCategory @default(OTHER)
  contactName  String?
  email        String?
  phone        String?
  paymentTerms String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  archivedAt   DateTime?
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations  Reservation[]
  supplierBills SupplierBill[]
  @@unique([id, tenantId])
  @@index([tenantId, archivedAt, name])
  @@index([tenantId, category])
  @@map("suppliers")
}
model Reservation {
  id          String                @id @default(cuid())
  tenantId    String
  branchId    String?
  customerId  String
  supplierId  String?
  supplierTenantId String?
  reference   String
  serviceType ReservationServiceType
  status      ReservationStatus     @default(INQUIRY)
  startDate   DateTime?
  endDate     DateTime?
  currency    String                @default("EGP")
  saleAmount  Decimal               @default(0) @db.Decimal(14, 2)
  costAmount  Decimal               @default(0) @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  archivedAt  DateTime?
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?               @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer    Customer              @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  supplier    Supplier?             @relation(fields: [supplierId, tenantId], references: [id, tenantId], onDelete: Restrict)
  invoices      Invoice[]
  supplierBills SupplierBill[]
  hotelDetail HotelReservationDetail?
  documents   Document[]
  @@unique([id, tenantId])
  @@unique([tenantId, reference])
  @@index([tenantId, status, startDate])
  @@index([tenantId, customerId])
  @@index([tenantId, branchId, status, startDate])
  @@map("reservations")
}

model HotelReservationDetail {
  id                    String   @id @default(cuid())
  tenantId              String
  reservationId         String
  hotelId               String?
  hotelName             String?
  clientNationality     String?
  guestName             String
  guestNationality      String?
  guestPhone            String?
  rateCode              String?
  clientOptionDate      DateTime?
  hotelOptionDate       DateTime?
  termsAndConditions    String?
  generalPolicy         String?
  tags                  String[] @default([])
  fileNo                String?
  reservationRemarks    String?
  roomNumber            String?
  hotelConfirmationNumber String?
  voucher               String?
  referenceNumber       String?
  detailRemarks         String?
  agreementNumber       String?
  costCenter            String?
  hotelRemarks          String?
  company               String?
  subClient             String?
  salesperson           String?
  channel               String?
  clientRemarks         String?
  bank                  String?
  paymentMethod         String?
  isManualRate          Boolean  @default(false)
  pricesIncludeVat      Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation           Reservation @relation(fields: [reservationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  hotel                 Hotel? @relation(fields: [hotelId, tenantId], references: [id, tenantId], onDelete: Restrict)
  rooms                 HotelReservationRoom[]
  @@unique([id, tenantId])
  @@unique([reservationId, tenantId])
  @@index([tenantId, fileNo])
  @@index([tenantId, hotelName])
  @@map("hotel_reservation_details")
}

model HotelReservationRoom {
  id             String   @id @default(cuid())
  tenantId       String
  hotelDetailId  String
  roomCount      Int      @default(1)
  roomType       String
  mealPlan       String
  adults         Int      @default(1)
  children       Int      @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  hotelDetail    HotelReservationDetail @relation(fields: [hotelDetailId, tenantId], references: [id, tenantId], onDelete: Cascade)
  nightlyRates   HotelReservationNightRate[]
  @@unique([id, tenantId])
  @@index([tenantId, hotelDetailId, sortOrder])
  @@map("hotel_reservation_rooms")
}

model HotelReservationNightRate {
  id                String   @id @default(cuid())
  tenantId          String
  roomId            String
  stayDate          DateTime
  saleRoomRate      Decimal  @default(0) @db.Decimal(14, 2)
  saleMealRatePerPax Decimal @default(0) @db.Decimal(14, 2)
  saleVat           Decimal  @default(0) @db.Decimal(14, 2)
  costRoomRate      Decimal  @default(0) @db.Decimal(14, 2)
  costMealRatePerPax Decimal @default(0) @db.Decimal(14, 2)
  costVat           Decimal  @default(0) @db.Decimal(14, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  room              HotelReservationRoom @relation(fields: [roomId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@unique([tenantId, roomId, stayDate])
  @@index([tenantId, stayDate])
  @@map("hotel_reservation_night_rates")
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_events")
}


model Document {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  reservationId String?
  uploadedById  String
  objectKey     String   @unique
  originalName  String
  mimeType      String
  size          Int
  sha256        String
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?  @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reservation   Reservation? @relation(fields: [reservationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  uploadedBy    User     @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  @@unique([id, tenantId])
  @@index([tenantId, reservationId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@map("documents")
}

model LedgerAccount {
  id           String            @id @default(cuid())
  tenantId     String
  code         String
  name         String
  nameEn       String
  type         LedgerAccountType
  isSystem     Boolean           @default(false)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  invoiceLines InvoiceLine[]
  customerPayments CustomerPayment[]
  supplierBillLines SupplierBillLine[]
  supplierPayments SupplierPayment[]
  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, type, isActive])
  @@map("ledger_accounts")
}

model JournalEntry {
  id             String             @id @default(cuid())
  tenantId       String
  branchId       String
  reference      String
  entryDate      DateTime
  description    String
  currency       String             @default("EGP")
  exchangeRate   Decimal            @default(1) @db.Decimal(18, 8)
  status         JournalEntryStatus @default(POSTED)
  sourceType     JournalSourceType  @default(MANUAL)
  idempotencyKey String?
  requestHash    String?
  reversalOfId   String?
  createdById    String?
  postedAt       DateTime           @default(now())
  createdAt      DateTime           @default(now())
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch             @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines          JournalLine[]
  reversalOf     JournalEntry?      @relation("JournalReversals", fields: [reversalOfId, tenantId], references: [id, tenantId], onDelete: NoAction)
  reversals      JournalEntry[]     @relation("JournalReversals")
  invoices       Invoice[]
  customerPayments CustomerPayment[]
  supplierBills SupplierBill[]
  supplierPayments SupplierPayment[]
  @@unique([id, tenantId])
  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, reversalOfId])
  @@index([tenantId, entryDate, status])
  @@index([tenantId, sourceType, entryDate])
  @@index([tenantId, branchId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id             String        @id @default(cuid())
  tenantId       String
  journalEntryId String
  accountId      String
  memo           String?
  debit          Decimal       @default(0) @db.Decimal(14, 2)
  credit         Decimal       @default(0) @db.Decimal(14, 2)
  baseDebit      Decimal       @default(0) @db.Decimal(14, 2)
  baseCredit     Decimal       @default(0) @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())
  journalEntry   JournalEntry  @relation(fields: [journalEntryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  account        LedgerAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@index([tenantId, journalEntryId])
  @@index([tenantId, accountId])
  @@map("journal_lines")
}


model Invoice {
  id              String       @id @default(cuid())
  tenantId        String
  branchId        String
  customerId      String
  reservationId   String?
  journalEntryId  String
  reference       String
  issueDate       DateTime
  dueDate         DateTime?
  status          InvoiceStatus @default(ISSUED)
  currency        String        @default("EGP")
  exchangeRate    Decimal       @default(1) @db.Decimal(18, 8)
  subtotal        Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  total           Decimal       @db.Decimal(14, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(14, 2)
  notes           String?
  idempotencyKey  String
  requestHash     String
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer        Customer      @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reservation     Reservation?  @relation(fields: [reservationId, tenantId], references: [id, tenantId], onDelete: NoAction)
  journalEntry    JournalEntry  @relation(fields: [journalEntryId, tenantId], references: [id, tenantId], onDelete: NoAction)
  lines           InvoiceLine[]
  payments        CustomerPayment[]
  @@unique([id, tenantId])
  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, journalEntryId])
  @@index([tenantId, status, issueDate])
  @@index([tenantId, customerId, issueDate])
  @@index([tenantId, branchId, issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id                String        @id @default(cuid())
  tenantId          String
  invoiceId         String
  revenueAccountId  String
  description       String
  quantity          Decimal       @db.Decimal(14, 2)
  unitPrice         Decimal       @db.Decimal(14, 2)
  amount            Decimal       @db.Decimal(14, 2)
  createdAt         DateTime      @default(now())
  invoice           Invoice       @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  revenueAccount    LedgerAccount @relation(fields: [revenueAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@index([tenantId, invoiceId])
  @@index([tenantId, revenueAccountId])
  @@map("invoice_lines")
}

model CustomerPayment {
  id              String                @id @default(cuid())
  tenantId        String
  branchId        String
  invoiceId       String
  accountId       String
  journalEntryId  String
  receiptNumber   String
  paymentDate     DateTime
  method          CustomerPaymentMethod
  amount          Decimal               @db.Decimal(14, 2)
  currency        String                @default("EGP")
  exchangeRate    Decimal               @default(1) @db.Decimal(18, 8)
  idempotencyKey  String
  requestHash     String
  reference       String?
  notes           String?
  createdById     String?
  createdAt       DateTime              @default(now())
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  invoice         Invoice               @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  account         LedgerAccount         @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  journalEntry    JournalEntry          @relation(fields: [journalEntryId, tenantId], references: [id, tenantId], onDelete: NoAction)
  @@unique([id, tenantId])
  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, journalEntryId])
  @@index([tenantId, paymentDate])
  @@index([tenantId, invoiceId, paymentDate])
  @@index([tenantId, branchId, paymentDate])
  @@map("customer_payments")
}


model SupplierBill {
  id              String            @id @default(cuid())
  tenantId        String
  branchId        String
  supplierId      String
  reservationId   String?
  journalEntryId  String
  reference       String
  supplierReference String?
  billDate        DateTime
  dueDate         DateTime?
  status          SupplierBillStatus @default(ISSUED)
  currency        String             @default("EGP")
  exchangeRate    Decimal            @default(1) @db.Decimal(18, 8)
  subtotal        Decimal            @db.Decimal(14, 2)
  taxAmount       Decimal            @default(0) @db.Decimal(14, 2)
  total           Decimal            @db.Decimal(14, 2)
  paidAmount      Decimal            @default(0) @db.Decimal(14, 2)
  notes           String?
  idempotencyKey  String
  requestHash     String
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch             @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  supplier        Supplier           @relation(fields: [supplierId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reservation     Reservation?       @relation(fields: [reservationId, tenantId], references: [id, tenantId], onDelete: NoAction)
  journalEntry    JournalEntry       @relation(fields: [journalEntryId, tenantId], references: [id, tenantId], onDelete: NoAction)
  lines           SupplierBillLine[]
  payments        SupplierPayment[]
  @@unique([id, tenantId])
  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, journalEntryId])
  @@index([tenantId, status, billDate])
  @@index([tenantId, supplierId, billDate])
  @@index([tenantId, branchId, billDate])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id               String        @id @default(cuid())
  tenantId         String
  supplierBillId   String
  expenseAccountId String
  description      String
  quantity         Decimal       @db.Decimal(14, 2)
  unitPrice        Decimal       @db.Decimal(14, 2)
  amount           Decimal       @db.Decimal(14, 2)
  createdAt        DateTime      @default(now())
  supplierBill     SupplierBill  @relation(fields: [supplierBillId, tenantId], references: [id, tenantId], onDelete: Cascade)
  expenseAccount   LedgerAccount @relation(fields: [expenseAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@index([tenantId, supplierBillId])
  @@index([tenantId, expenseAccountId])
  @@map("supplier_bill_lines")
}

model SupplierPayment {
  id              String                @id @default(cuid())
  tenantId        String
  branchId        String
  supplierBillId  String
  accountId       String
  journalEntryId  String
  paymentNumber   String
  paymentDate     DateTime
  method          CustomerPaymentMethod
  amount          Decimal               @db.Decimal(14, 2)
  currency        String                @default("EGP")
  exchangeRate    Decimal               @default(1) @db.Decimal(18, 8)
  idempotencyKey  String
  requestHash     String
  reference       String?
  notes           String?
  createdById     String?
  createdAt       DateTime              @default(now())
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  supplierBill    SupplierBill          @relation(fields: [supplierBillId, tenantId], references: [id, tenantId], onDelete: Restrict)
  account         LedgerAccount         @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  journalEntry    JournalEntry          @relation(fields: [journalEntryId, tenantId], references: [id, tenantId], onDelete: NoAction)
  @@unique([id, tenantId])
  @@unique([tenantId, paymentNumber])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, journalEntryId])
  @@index([tenantId, paymentDate])
  @@index([tenantId, supplierBillId, paymentDate])
  @@index([tenantId, branchId, paymentDate])
  @@map("supplier_payments")
}

model PlatformCompanyApplication {
  id              String                   @id @default(cuid())
  userId          String                   @unique
  companyName     String
  legalName       String?
  country         String
  city            String
  phone           String
  defaultCurrency String                   @default("EGP")
  defaultLanguage String                   @default("ar")
  status          CompanyApplicationStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@map("platform_company_applications")
}
