DATABASE_URL="postgresql://app_user:change_me@localhost:5432/new_host_travel?schema=public"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
SEED_DEMO_DATA="false"

# Production runtime login must be separate from the migration/admin DATABASE_URL.
# Grant the login membership in the new_host_app role created by migrations.
APP_DATABASE_URL=""

# Transactional email (verify your sender domain with Resend before production use)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="New Host Travel <no-reply@example.com>"

# Private S3-compatible object storage for passport and travel documents
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# The single verified system owner allowed to bootstrap the first account and administer the company.
SYSTEM_OWNER_EMAIL="newhosttr3vel@gmail.com"
